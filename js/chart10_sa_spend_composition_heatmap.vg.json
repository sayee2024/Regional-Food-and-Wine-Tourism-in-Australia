{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Share of domestic visitor-origin spending across six named food-bowl-associated South Australian tourism reporting regions in year ending December 2024. Original 33-row SATC-derived CSV is unchanged; filter selects 18 cells. All-purpose domestic tourism, not food-and-wine venue sales.",
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "data": {
    "url": "data/chart10_sa_domestic_spend_composition_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "region_sort_rank": "number",
        "category_sort_rank": "number",
        "category_spend_AUD_million": "number",
        "region_total_domestic_spend_AUD_million": "number",
        "share_of_region_domestic_spend_pct": "number",
        "display_share_pct": "number"
      }
    }
  },
  "transform": [
    {
      "filter": {
        "field": "tourism_region",
        "oneOf": [
          "Limestone Coast",
          "Fleurieu Peninsula",
          "Barossa",
          "Adelaide Hills",
          "Clare Valley",
          "Kangaroo Island"
        ]
      }
    },
    {
      "calculate": "format(datum.display_share_pct, '.1f') + '%'",
      "as": "cell_label"
    }
  ],
  "encoding": {
    "x": {
      "field": "visitor_category",
      "type": "nominal",
      "sort": [
        "Interstate overnight",
        "Intrastate overnight",
        "Domestic daytrip"
      ],
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "labelLimit": 195,
        "tickSize": 0,
        "domain": false,
        "labelPadding": 10
      }
    },
    "y": {
      "field": "tourism_region",
      "type": "nominal",
      "sort": [
        "Limestone Coast",
        "Fleurieu Peninsula",
        "Barossa",
        "Adelaide Hills",
        "Clare Valley",
        "Kangaroo Island"
      ],
      "title": null,
      "axis": {
        "labelFontSize": 12,
        "labelLimit": 255,
        "tickSize": 0,
        "domain": false,
        "labelPadding": 9
      }
    },
    "tooltip": [
      {
        "field": "tourism_region",
        "type": "nominal",
        "title": "South Australian tourism region"
      },
      {
        "field": "visitor_category",
        "type": "nominal",
        "title": "Visitor category"
      },
      {
        "field": "share_of_region_domestic_spend_pct",
        "type": "quantitative",
        "format": ".1f",
        "title": "Share of region domestic spend (%)"
      },
      {
        "field": "category_spend_AUD_million",
        "type": "quantitative",
        "format": ",.0f",
        "title": "Category spending (AUD million)"
      },
      {
        "field": "region_total_domestic_spend_AUD_million",
        "type": "quantitative",
        "format": ",.0f",
        "title": "Regional domestic total (AUD million)"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#FFFFFF",
        "strokeWidth": 2,
        "cornerRadius": 2
      },
      "encoding": {
        "color": {
          "field": "share_of_region_domestic_spend_pct",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              70
            ],
            "range": [
              "#F2F5ED",
              "#246B5D"
            ]
          },
          "legend": {
            "title": "Share of region spend (%)",
            "orient": "top",
            "direction": "horizontal",
            "gradientLength": 240,
            "values": [
              0,
              20,
              40,
              60
            ],
            "labelFontSize": 11,
            "titleFontSize": 12,
            "labelColor": "#233F34",
            "titleColor": "#233F34"
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 13,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "cell_label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.share_of_region_domestic_spend_pct >= 46",
            "value": "#FFFFFF"
          },
          "value": "#244638"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#233F34",
      "titleColor": "#233F34"
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "titleLimit": 450,
      "labelLimit": 250
    }
  }
}
