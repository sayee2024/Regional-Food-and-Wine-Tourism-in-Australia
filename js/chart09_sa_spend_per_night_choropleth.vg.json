              "calculate": "{\"Adelaide Hills\": \"1. Adelaide Hills\", \"Barossa\": \"2. Barossa\", \"Clare Valley\": \"3. Clare Valley\", \"Fleurieu Peninsula\": \"4. Fleurieu Peninsula\", \"Kangaroo Island\": \"5. Kangaroo Island\", \"Limestone Coast\": \"6. Limestone Coast\"}[datum.tourism_region]",
