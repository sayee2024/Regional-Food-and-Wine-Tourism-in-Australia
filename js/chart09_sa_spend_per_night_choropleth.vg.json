{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "All-SA rate choropleth for 11 original 2024 tourism regions with named food-bowl outlines, paired with a quantitative ranked bar chart of the same measure for the six named food-bowl reporting regions. Original geometry and rates unchanged. Replaces misleading disconnected six-region map inset. Checkpoint 20: SA central meridian, numbered geographic callouts tied to ranked labels, thinner region outlines and readable legend.",
  "hconcat": [
    {
      "title": {
        "text": "All tourism regions",
        "fontSize": 13,
        "fontWeight": "bold",
        "anchor": "start",
        "offset": 8,
        "color": "#3C5A50"
      },
      "width": 410,
      "height": 460,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -28,
          -37
        ],
        "rotate": [
          -135,
          0
        ],
        "center": [
          0,
          -32
        ]
      },
      "layer": [
        {
          "data": {
            "url": "data/chart09_sa_domestic_spend_per_night_2024.json",
            "format": {
              "type": "topojson",
              "feature": "chart09_sa_domestic_spend_per_night_2024"
            }
          },
          "transform": [
            {
              "calculate": "datum.properties.atdw_food_bowl_matching_status === 'name_match_or_variant' ? 'Named food bowl' : datum.properties.atdw_food_bowl_matching_status === 'broader_region_not_same_footprint' ? 'Flinders proxy' : 'Other SA region'",
              "as": "food_bowl_geo_link"
            }
          ],
          "mark": {
            "type": "geoshape",
            "strokeWidth": 1.2
          },
          "encoding": {
            "color": {
              "field": "properties.rate_display_AUD",
              "type": "quantitative",
              "title": "AUD per domestic visitor-night",
              "scale": {
                "type": "linear",
                "scheme": "blues",
                "domain": [
                  100,
                  260
                ]
              },
              "legend": {
                "orient": "top",
                "direction": "horizontal",
                "title": "AUD per domestic visitor-night",
                "format": ",.0f",
                "values": [
                  100,
                  140,
                  180,
                  220,
                  260
                ],
                "gradientLength": 250
              }
            },
            "tooltip": [
              {
                "field": "properties.tourism_region",
                "type": "nominal",
                "title": "Tourism region"
              },
              {
                "field": "food_bowl_geo_link",
                "type": "nominal",
                "title": "Food-bowl geographic link"
              },
              {
                "field": "properties.rate_display_AUD",
                "type": "quantitative",
                "title": "Domestic spend per visitor-night (AUD)",
                "format": ",.0f"
              },
              {
                "field": "properties.domestic_overnight_spend_million_AUD",
                "type": "quantitative",
                "title": "Domestic overnight spend (AUD million)",
                "format": ",.0f"
              },
              {
                "field": "properties.domestic_visitor_nights_000",
                "type": "quantitative",
                "title": "Domestic overnight visitor-nights (000s)",
                "format": ",.0f"
              },
              {
                "field": "properties.atdw_food_bowl_label",
                "type": "nominal",
                "title": "Associated named food bowl"
              }
            ],
            "stroke": {
              "condition": {
                "test": "datum.food_bowl_geo_link === 'Named food bowl'",
                "value": "#173B33"
              },
              "value": "#FFFFFF"
            },
            "strokeWidth": {
              "condition": {
                "test": "datum.food_bowl_geo_link === 'Named food bowl'",
                "value": 1.5
              },
              "value": 1.0
            }
          }
        },
