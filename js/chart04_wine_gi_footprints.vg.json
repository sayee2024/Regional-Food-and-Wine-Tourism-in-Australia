{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "National recognised wine GI geography 2026. Layered full Australian state outlines (derived from 2021 TRA geography), all 64 Wine Australia GI polygons and centroid markers for visibility, plus eight exact-name food-bowl matches. Companion stacked count bars by state. No tourism visitor counts are implied by the GI markers. Checkpoint 20: Australian central meridian, subtle full state names and full-name state counts and numbered wine-region callouts.",
  "hconcat": [
    {
      "title": {
        "text": "Wine-region map",
        "fontSize": 13,
        "fontWeight": "bold",
        "anchor": "start",
        "offset": 8,
        "color": "#3C5A50"
      },
      "width": 510,
      "height": 440,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -132,
          0
        ],
        "center": [
          0,
          -27
        ]
      },
      "layer": [
        {
          "data": {
            "url": "data/chart04_australian_state_outlines_2021.json",
            "format": {
              "type": "topojson",
              "feature": "chart04_australian_state_outlines_2021"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#EFF2ED",
            "stroke": "#BCC8C0",
            "strokeWidth": 1.1
          },
          "encoding": {
            "tooltip": [
              {
                "field": "properties.state",
                "type": "nominal",
                "title": "State / territory"
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/chart05_state_labels_2021.csv",
            "format": {
              "type": "csv",
              "parse": {
                "lon": "number",
                "lat": "number"
              }
            }
          },
          "mark": {
            "type": "text",
            "font": "Arial",
            "fontSize": 10,
            "fontWeight": "normal",
            "fill": "#6B7B71",
            "opacity": 0.7,
            "stroke": "#FFFDF9",
            "strokeWidth": 3,
            "strokeJoin": "round"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "state",
              "type": "nominal"
            },
            "tooltip": [
              {
                "field": "state",
                "type": "nominal",
                "title": "State / territory"
              }
            ]
          },
          "transform": [
            {
              "filter": "datum.state != 'Australian Capital Territory'"
            }
          ]
        },
        {
          "data": {
            "url": "data/chart05_state_labels_2021.csv",
            "format": {
              "type": "csv",
              "parse": {
                "lon": "number",
                "lat": "number"
              }
            }
          },
          "mark": {
            "type": "text",
            "font": "Arial",
            "fontSize": 10,
            "fontWeight": "normal",
            "fill": "#42574D",
            "opacity": 0.7
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "state",
              "type": "nominal"
            },
            "tooltip": [
              {
                "field": "state",
                "type": "nominal",
                "title": "State / territory"
              }
            ]
          },
          "transform": [
            {
              "filter": "datum.state != 'Australian Capital Territory'"
            }
          ]
        },
        {
          "data": {
            "url": "data/chart04_wine_gi_footprints_2026.json",
            "format": {
              "type": "topojson",
              "feature": "chart04_wine_gi_footprints_2026"
            }
          },
          "transform": [
            {
              "calculate": "datum.properties.STATE === 'SA' ? 'South Australia' : datum.properties.STATE === 'NSW' ? 'New South Wales' : datum.properties.STATE === 'VIC' ? 'Victoria' : datum.properties.STATE === 'WA' ? 'Western Australia' : datum.properties.STATE === 'QLD' ? 'Queensland' : datum.properties.STATE === 'TAS' ? 'Tasmania' : datum.properties.STATE",
              "as": "full_state"
            }
          ],
          "mark": {
            "type": "geoshape",
            "stroke": "#DCE6DA",
            "strokeWidth": 0.6
          },
          "encoding": {
            "color": {
              "field": "properties.ATDW_EXACT_NAME_MATCH",
              "type": "nominal",
              "scale": {
                "domain": [
                  0,
                  1
                ],
                "range": [
                  "#A8C5BA",
                  "#C17B40"
                ]
              },
              "legend": null
