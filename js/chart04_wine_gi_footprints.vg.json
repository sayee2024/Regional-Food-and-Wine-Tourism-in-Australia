                "field": "properties.GI_NAME",
                "type": "nominal",
                "title": "GI wine region"
              },
              {
                "field": "full_state",
                "type": "nominal",
                "title": "State"
              },
              {
                "field": "properties.GI_AREA_KM2",
                "type": "quantitative",
                "title": "GI area (km²)",
                "format": ",.0f"
              }
            ]
          }
        },
