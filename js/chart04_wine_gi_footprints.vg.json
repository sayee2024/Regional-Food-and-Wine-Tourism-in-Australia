          "data": {
            "url": "data/chart04_wine_gi_state_totals_2026.csv"
          },
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 5,
            "baseline": "middle",
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#28584B"
