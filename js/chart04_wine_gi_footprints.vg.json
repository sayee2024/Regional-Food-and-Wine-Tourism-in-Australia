    {
      "title": {
        "text": "Counts by state",
        "fontSize": 13,
        "fontWeight": "bold",
        "anchor": "start",
        "offset": 8,
        "color": "#3C5A50"
      },
      "width": 210,
      "height": 300,
      "layer": [
        {
          "data": {
            "url": "data/chart04_wine_gi_counts_by_state_2026.csv"
          },
          "mark": {
            "type": "bar",
            "size": 24
          },
          "encoding": {
            "y": {
              "field": "state",
              "type": "nominal",
              "sort": [
                "Victoria",
                "South Australia",
                "New South Wales",
                "Western Australia",
                "Queensland",
                "Tasmania"
              ],
              "title": null,
              "axis": {
                "labelFontSize": 12,
                "labelFontWeight": "bold",
                "labelPadding": 8
              }
            },
            "x": {
              "field": "region_count",
              "type": "quantitative",
              "stack": "zero",
              "title": "Number of wine regions",
              "scale": {
                "domain": [
                  0,
                  23
                ]
              },
              "axis": {
                "grid": true,
                "tickMinStep": 5
              }
            },
            "color": {
              "field": "category",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "Other GI region",
                  "Food-bowl name match"
                ],
                "range": [
                  "#A8C5BA",
                  "#C17B40"
                ]
              },
              "legend": {
                "orient": "top",
                "direction": "vertical",
                "values": [
                  "Food-bowl name match",
                  "Other GI region"
                ],
                "labelExpr": "datum.label === 'Other GI region' ? 'Other recognised region' : datum.label"
              }
            },
            "tooltip": [
              {
                "field": "state",
                "type": "nominal",
                "title": "State"
              },
              {
                "field": "category",
                "type": "nominal",
                "title": "Type"
              },
              {
                "field": "region_count",
                "type": "quantitative",
                "title": "Recognised regions"
              }
            ]
          }
        },
