{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional-symbol map of 2024 domestic overnight trips in 16 selected Australian TRA tourism reporting regions associated by name or broader geography with ATDW food-bowl destinations. Figures count all domestic overnight trips in the regions, not food- or wine-activity-specific trips. Map display repair: correct winding on two tiny island polygons and use automatic fit of the existing conicEqualArea projection. Regional data and coordinates unchanged. Added a labeled state/territory layer derived from the 2021 underlying regional boundary names; overlay follows Week 8 projected text technique. Checkpoint 20: rotate to Australian central meridian, render label fill above halo, draw smaller bubbles last, preserve linear area encoding and use precise legend labels.",
  "width": "container",
  "height": 470,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ],
    "center": [
      0,
      -27
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/chart05_tourism_regions_2021.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#EDF1EB",
        "stroke": "#CBD4CC",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "data/chart05_regional_overnight_trips_2024.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lon": "number",
            "lat": "number",
            "domestic_overnight_trips_2024": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "opacity": 0.77,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.25
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "domestic_overnight_trips_2024",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              5000000
            ],
            "range": [
              0,
              2400
            ]
          },
          "legend": {
            "title": "Domestic overnight trips (2024)",
            "orient": "bottom",
            "format": ".2~s",
            "values": [
              500000,
              1500000,
              3000000,
              4500000
            ]
          }
        },
        "color": {
          "field": "geographic_match_status",
          "type": "nominal",
          "scale": {
            "domain": [
              "direct_or_minor_name_variant",
              "broader_proxy"
            ],
            "range": [
              "#24736A",
              "#B47D42"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "tourism_region",
            "type": "nominal",
            "title": "TRA tourism region"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "domestic_overnight_trips_2024",
            "type": "quantitative",
            "title": "Domestic overnight trips (2024)",
            "format": ",.0f"
          },
          {
            "field": "associated_atdw_food_bowl_names",
            "type": "nominal",
            "title": "Associated named food bowl(s)"
          },
          {
            "field": "scope_note",
            "type": "nominal",
            "title": "Reporting scope"
          }
        ],
        "order": {
          "field": "domestic_overnight_trips_2024",
          "type": "quantitative",
          "sort": "descending"
        }
      }
    },
    {
      "data": {
        "url": "data/chart05_state_labels_2021.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 14,
        "fontWeight": "bold",
        "opacity": 1,
        "stroke": "#FFFDF9",
        "strokeWidth": 3,
        "strokeJoin": "round"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/chart05_state_labels_2021.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 14,
        "fontWeight": "bold",
        "opacity": 1,
        "fill": "#42574D"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "titleLimit": 450,
      "labelLimit": 250
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  }
}
