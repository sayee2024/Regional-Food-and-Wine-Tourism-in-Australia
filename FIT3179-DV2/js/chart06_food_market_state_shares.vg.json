{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Share of domestic food-market-including trips and share of overall leisure/business trips visiting each Australian state/territory in 2024. These are separate denominators and state visitation, not direct evidence of market visits happening in that state.",
  "data": {
    "url": "data/chart06_food_market_state_destination_shares_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "food_market_trip_share_pct": "number",
        "all_leisure_business_trip_share_pct": "number",
        "difference_percentage_points": "number",
        "year": "number"
      }
    }
  },
  "transform": [
    {
      "fold": [
        "food_market_trip_share_pct",
        "all_leisure_business_trip_share_pct"
      ],
      "as": [
        "metric",
        "share_pct"
      ]
    },
    {
      "calculate": "datum.metric === \"food_market_trip_share_pct\" ? \"Food-market trips\" : \"All leisure/business trips\"",
      "as": "visitor_group"
    }
  ],
  "width": "container",
  "height": 335,
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3,
    "size": 14
  },
  "encoding": {
    "y": {
      "field": "state",
      "type": "nominal",
      "sort": {
        "field": "food_market_trip_share_pct",
        "order": "descending"
      },
      "axis": {
        "title": null,
        "labelFontSize": 12,
        "labelLimit": 300
      }
    },
    "yOffset": {
      "field": "visitor_group",
      "sort": [
        "Food-market trips",
        "All leisure/business trips"
      ]
    },
    "x": {
      "field": "share_pct",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          35
        ]
      },
      "axis": {
        "title": "Share of trips that visited state (%)",
        "tickCount": 6,
        "labelExpr": "datum.value + \"%\""
      }
    },
    "color": {
      "field": "visitor_group",
      "type": "nominal",
      "scale": {
        "domain": [
          "Food-market trips",
          "All leisure/business trips"
        ],
        "range": [
          "#24736A",
          "#B47D42"
        ]
      },
      "legend": {
        "title": "Trip category",
        "orient": "top",
        "direction": "horizontal",
        "labelLimit": 230
      }
    },
    "tooltip": [
      {
        "field": "state",
        "type": "nominal",
        "title": "State / territory"
      },
      {
        "field": "visitor_group",
        "type": "nominal",
        "title": "Trip category"
      },
      {
        "field": "share_pct",
        "type": "quantitative",
        "format": ".0f",
        "title": "Share visiting state (%)"
      },
      {
        "field": "difference_percentage_points",
        "type": "quantitative",
        "format": "+.0f",
        "title": "Food-market − overall (pp)"
      },
      {
        "field": "year",
        "type": "ordinal",
        "title": "Reference year"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#22382F",
      "titleColor": "#22382F",
      "gridColor": "#E9E5DE"
    },
    "legend": {
      "titleLimit": 450,
      "labelLimit": 250
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  }
}
