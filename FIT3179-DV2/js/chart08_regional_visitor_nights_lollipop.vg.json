{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Lollipop plot of reported 2024 domestic overnight visitor-nights in 16 selected TRA tourism regions associated by names with ATDW food-bowl destinations. All-purpose regional tourism, not food/wine activity-specific. Australia's South West is a larger regional proxy. Compiler repair: explicit shared quantitative x encoding for rule, point and label; rule spans visitor nights to zero.",
  "data": {
    "url": "data/chart08_national_regional_visitor_nights_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "domestic_overnight_trips_2024": "number",
        "domestic_visitor_nights_2024": "number",
        "average_stay_nights_published": "number",
        "year": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.geographic_match_status === 'broader_proxy' ? 'Broader-region proxy' : 'Named-region association'",
      "as": "region_match_label"
    },
    {
      "calculate": "format(datum.domestic_visitor_nights_2024 / 1000000, '.1f') + 'M'",
      "as": "nights_display"
    }
  ],
  "width": "container",
  "height": 600,
  "encoding": {
    "y": {
      "field": "tourism_region",
      "type": "nominal",
      "sort": {
        "field": "domestic_visitor_nights_2024",
        "order": "descending"
      },
      "axis": {
        "title": null,
        "labelFontSize": 11,
        "labelLimit": 300,
        "labelPadding": 8,
        "tickSize": 0,
        "domain": false
      }
    },
    "x": {
      "field": "domestic_visitor_nights_2024",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          16500000
        ]
      },
      "axis": {
        "title": "Domestic overnight visitor-nights (2024)",
        "format": "~s",
        "tickCount": 7
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#CCD4CD",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "domestic_visitor_nights_2024",
          "type": "quantitative"
        },
        "x2": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 135,
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "region_match_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "Named-region association",
              "Broader-region proxy"
            ],
            "range": [
              "#24736A",
              "#B47D42"
            ]
          },
          "legend": {
            "title": "Food-bowl geographical association",
            "orient": "bottom",
            "direction": "horizontal",
            "labelLimit": 260
          }
        },
        "tooltip": [
          {
            "field": "tourism_region",
            "type": "nominal",
            "title": "TRA tourism region"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "domestic_visitor_nights_2024",
            "type": "quantitative",
            "title": "Domestic visitor-nights",
            "format": ",.0f"
          },
          {
            "field": "domestic_overnight_trips_2024",
            "type": "quantitative",
            "title": "Domestic overnight trips",
            "format": ",.0f"
          },
          {
            "field": "average_stay_nights_published",
            "type": "quantitative",
            "title": "Published average stay (nights)",
            "format": ".1f"
          },
          {
            "field": "related_food_bowls",
            "type": "nominal",
            "title": "Associated food-bowl names"
          },
          {
            "field": "region_match_label",
            "type": "nominal",
            "title": "Geographic match"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#22382F"
      },
      "encoding": {
        "text": {
          "field": "nights_display",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#22382F",
      "titleColor": "#22382F",
      "gridColor": "#E7EAE4"
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#22382F",
      "titleLimit": 450,
      "labelLimit": 250
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  }
}
